# Official ESP32-S3-DevKitC-1 with ESP32-S3-WROOM-2-N32R16V.
# 1.8 V octal flash/PSRAM are internal to the module; external GPIOs are 3.3 V.
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_OCT_FLASH=y
CONFIG_ESPTOOLPY_FLASHMODE_OPI=y
CONFIG_ESPTOOLPY_FLASH_SAMPLE_MODE_DTR=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_32MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_MEMTEST=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=n
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536
# Keep PSRAM's full nominal capacity; size is detected and checked at runtime.
CONFIG_SPIRAM_ECC_ENABLE=n

# Retain the existing conservative app partition. 32 MB physical flash does
# not require expanding it or inventing an OTA/storage layout in this step.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_TESLA_HEADUP_DISPLAY_RGB=y
CONFIG_TESLA_HEADUP_RGB_ORIGIN_X=132
CONFIG_TESLA_HEADUP_RGB_ORIGIN_Y=0
CONFIG_TESLA_HEADUP_RGB_PCLK_HZ=29200000
# Bounce-buffer reads and callbacks must remain usable during NVS/flash writes.
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
