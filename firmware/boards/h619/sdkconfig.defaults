# LILYGO T-Display-S3 AMOLED 1.91-inch, non-touch H619 profile.
CONFIG_TESLA_HEADUP_DISPLAY_RGB=n
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y

# Leave headroom beyond the default 1 MiB application partition.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

CONFIG_TESLA_HEADUP_DISPLAY_SPI_CLOCK_HZ=75000000
CONFIG_TESLA_HEADUP_DISPLAY_BUFFER_LINES=40
CONFIG_TESLA_HEADUP_DISPLAY_PIN_SCK=47
CONFIG_TESLA_HEADUP_DISPLAY_PIN_DATA0=18
CONFIG_TESLA_HEADUP_DISPLAY_PIN_DATA1=7
CONFIG_TESLA_HEADUP_DISPLAY_PIN_DATA2=48
CONFIG_TESLA_HEADUP_DISPLAY_PIN_DATA3=5
CONFIG_TESLA_HEADUP_DISPLAY_PIN_CS=6
CONFIG_TESLA_HEADUP_DISPLAY_PIN_RESET=17
CONFIG_TESLA_HEADUP_DISPLAY_PIN_POWER=38
CONFIG_TESLA_HEADUP_DISPLAY_PROJECTION_MIRRORED=y
